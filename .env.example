# Copy to .env:  Copy-Item .env.example .env
COMPOSE_PROFILES=core

POSTGRES_USER=foodrescue
POSTGRES_PASSWORD=foodrescue
POSTGRES_DB=foodrescue
POSTGRES_PORT=5433

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Activates the production JWT-secret guard (config.py).
# The backend and worker containers will refuse to start unless JWT_SECRET is
# at least 32 bytes and is not the development placeholder.
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
FOODRESCUE_ENV=production
JWT_SECRET=change-me-in-real-deployments-minimum-32-bytes

# Simulator also POSTs batches straight to /ingest/batch. Set false once NiFi owns data/inbox.
SIM_DIRECT_INGEST=true
